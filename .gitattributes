# Shell scripts must keep LF endings even when checked out on Windows.
# The backend Dockerfile runs dos2unix as a safety net, but the frontend
# Dockerfile does not -- a CRLF docker-entrypoint.sh fails at container start
# with "exec format error" / ": not found".
*.sh text eol=lf

# Windows-only helpers stay CRLF.
*.ps1 text eol=crlf

# Config files consumed inside Linux containers.
Dockerfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.conf text eol=lf
